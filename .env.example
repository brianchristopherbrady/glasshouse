# Copy to .env for `docker compose up`. Never commit real values.

# Required
POSTGRES_PASSWORD=change-me
# Bootstrap admin token: sign in with this, then issue per-person tokens in Settings.
GLASSHOUSE_API_TOKEN=change-me-to-a-long-random-string

# Optional
PORT=4000
# Comma-separated browser origins allowed to call the API cross-origin.
GLASSHOUSE_ALLOWED_ORIGINS=
# Set to true when running behind a reverse proxy/load balancer.
GLASSHOUSE_TRUST_PROXY=false

# GitHub: either a personal access token...
GLASSHOUSE_GITHUB_TOKEN=
# ...or a GitHub App (preferred). The key may use literal \n for newlines.
GLASSHOUSE_GITHUB_APP_ID=
GLASSHOUSE_GITHUB_APP_PRIVATE_KEY=
# Secret configured on the GitHub webhook (event: Workflow runs).
GLASSHOUSE_GITHUB_WEBHOOK_SECRET=

# Error monitoring (optional)
SENTRY_DSN=
