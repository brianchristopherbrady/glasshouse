{
  "name": "@brianbrady/glasshouse-telemetry-client",
  "version": "0.1.2",
  "description": "Emit runtime telemetry from agents and CI jobs to a Glasshouse server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianchristopherbrady/glasshouse.git",
    "directory": "packages/telemetry-client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@brianbrady/glasshouse-domain": "^0.1.0"
  }
}
