{
  "name": "@agentic-flows/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agentic-flows": "./bin/agentic-flows.mjs"
  },
  "files": [
    "dist",
    "bin",
    "prisma/schema.prisma",
    "prisma/migrations"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && node scripts/bundle.mjs",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.5",
    "@prisma/client": "^5.21.1",
    "fastify": "^5.1.0",
    "prisma": "^5.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agentic-flows/domain": "*",
    "@agentic-flows/parser": "*",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  }
}
