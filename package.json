{
  "name": "glasshouse",
  "private": true,
  "version": "0.2.0",
  "description": "Observability and visualization for agentic software-development workflows.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/server & npm run dev --workspace apps/web",
    "build": "npm run build -w packages/domain && npm run build -w packages/parser && npm run build -w packages/telemetry-client && npm run build -w apps/web && npm run build -w apps/server",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "demo": "node scripts/demo-city.mjs",
    "city:replay": "node examples/agentic-city/tools/replay-founding.mjs",
    "city:reset": "node examples/agentic-city/tools/reset-city.mjs",
    "city:sync": "node examples/agentic-city/tools/sync-customizations.mjs",
    "db:generate": "npm run db:generate --workspace apps/server",
    "db:migrate": "npm run db:migrate --workspace apps/server",
    "db:seed": "npm run db:seed --workspace apps/server",
    "db:check": "npm run db:check --workspace apps/server"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true
  }
}
